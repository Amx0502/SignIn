# 统一数据库连接
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=SignIn
DATABASE_USER=root
DATABASE_PASSWORD=change-this-password

# 秒应扫码登录及 GraphQL 服务。通常无需修改 URL。
MIAOYING_QR_API_URL=https://service.hui51.cn/api/weixin
MIAOYING_GRAPHQL_URL=https://www.aiphoto8.cn/api/graphql
# 建议配置独立 Fernet 密钥；留空时会基于数据库密码派生。更换密钥后已有账号需重新扫码。
# 可用 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" 生成。
MIAOYING_TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key

# 腾讯位置服务
CLASS_CUBE_TENCENT_URL=https://apis.map.qq.com
CLASS_CUBE_TENCENT_KEY=your-tencent-location-service-key
CLASS_CUBE_TENCENT_DAILY_LIMIT=6000

# 可选：腾讯地图 JavaScript API GL 使用独立 Key 或自定义 SDK 地址
# CLASS_CUBE_TENCENT_JS_URL=https://map.qq.com/api/gljs
# CLASS_CUBE_TENCENT_JS_KEY=your-tencent-javascript-api-key

# 可选：腾讯地点搜索请求标识和跨进程限速文件
# CLASS_CUBE_TENCENT_USER_AGENT=SignIn-ClassCube/1.0
# CLASS_CUBE_TENCENT_RATE_FILE=/tmp/signin-class-cube-tencent.rate
